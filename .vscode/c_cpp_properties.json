{
    "configurations": [
        {
            "name": "eBPF",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include",
                "/usr/include/bpf"
            ],
            "defines": [
                "__TARGET_ARCH_x86",
                "__BPF_TRACING__"
            ],
            "compilerPath": "/usr/bin/clang",
            "compilerArgs": [
                "-target", "bpf",
                "-g", "-O2"
            ],
            "cStandard": "gnu11",
            "intelliSenseMode": "linux-clang-x64"
        }
    ],
    "version": 4
}